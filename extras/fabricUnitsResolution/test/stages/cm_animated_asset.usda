#usda 1.0
(
    defaultPrim = "CmAnim"
    metersPerUnit = 0.01
    upAxis = "Y"
    doc = "Animated cm-space prim. Translate goes from origin to (200,0,0) over frames 1-24."
    startTimeCode = 1
    endTimeCode = 24
)

def Xform "CmAnim"
{
    double3 xformOp:translate.timeSamples = {
        1: (0, 0, 0),
        24: (200, 0, 0),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
