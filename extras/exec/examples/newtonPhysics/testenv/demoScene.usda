#usda 1.0
# Demo scene for animated GIF — falling box with camera.
# Newton physics drives the FallingBox transform via OpenExec (no baking).
(
    defaultPrim = "World"
    endTimeCode = 120
    metersPerUnit = 1.0
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Y"
    kilogramsPerUnit = 1.0
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }

    def Camera "DemoCamera"
    {
        float focalLength = 35
        double3 xformOp:translate = (8, 6, 14)
        float3 xformOp:rotateXYZ = (-20, 28, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Dynamic rigid body — 1m cube starting at y=10.
    def Cube "FallingBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.278, 0.412, 1.0)]
        double size = 1.0
        double3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Static ground plane — flat box at y=0.
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.4, 0.42, 0.45)]
        double size = 1.0
        float3 xformOp:scale = (30, 0.1, 30)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
