#usda 1.0
# Mixed collision shapes: sphere, box, and capsule falling onto ground.
# Tests different collision geometry types.
(
    defaultPrim = "World"
    endTimeCode = 240
    metersPerUnit = 1.0
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
    kilogramsPerUnit = 1.0
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }

    def Sphere "FallingSphere" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]
        double radius = 0.5
        double3 xformOp:translate = (-2, 8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "FallingBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.2, 0.8, 0.2)]
        double size = 1.0
        double3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "FallingCapsule" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.2, 0.2, 0.8)]
        double height = 1.0
        double radius = 0.25
        uniform token axis = "Y"
        double3 xformOp:translate = (2, 12, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1.0
        float3 xformOp:scale = (50, 0.1, 50)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
