#usda 1.0
# Material friction test scene.
# A tilted ramp with two boxes that have different friction values.
# The low-friction box should slide faster than the high-friction box.
(
    defaultPrim = "World"
    endTimeCode = 240
    metersPerUnit = 1.0
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
    kilogramsPerUnit = 1.0
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }

    # Ramp — a static box rotated 30 degrees about Z to form a slope.
    def Cube "Ramp" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
        double size = 1.0
        float3 xformOp:scale = (20, 0.2, 5)
        double3 xformOp:translate = (0, 3, 0)
        float3 xformOp:rotateXYZ = (0, 0, 30)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    # Low friction box — should slide easily.
    def Cube "LowFrictionBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        rel material:binding:physics = </World/Looks/LowFrictionMaterial>
        color3f[] primvars:displayColor = [(0.2, 0.8, 0.2)]
        double size = 0.8
        double3 xformOp:translate = (-2, 6, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # High friction box — should slide slowly or stick.
    def Cube "HighFrictionBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        rel material:binding:physics = </World/Looks/HighFrictionMaterial>
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]
        double size = 0.8
        double3 xformOp:translate = (-2, 6, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "LowFrictionMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.1
            float physics:dynamicFriction = 0.05
            float physics:restitution = 0.2
        }

        def Material "HighFrictionMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.9
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0.1
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1.0
        float3 xformOp:scale = (50, 0.1, 50)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
