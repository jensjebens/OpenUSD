#usda 1.0
# Kinematic and dynamic body interaction test.
# A kinematic platform moves via timesampled translate while
# a dynamic box rests on top of it.
(
    defaultPrim = "World"
    endTimeCode = 240
    metersPerUnit = 1.0
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
    kilogramsPerUnit = 1.0
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }

    # Kinematic platform that slides horizontally over time.
    def Cube "KinematicPlatform" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = true
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.2)]
        double size = 1.0
        float3 xformOp:scale = (4, 0.2, 4)
        double3 xformOp:translate.timeSamples = {
            0: (0, 2, 0),
            60: (3, 2, 0),
            120: (0, 2, 0),
            180: (-3, 2, 0),
            240: (0, 2, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    # Dynamic box resting on the kinematic platform.
    def Cube "DynamicBox" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.2, 0.4, 0.9)]
        double size = 1.0
        double3 xformOp:translate = (0, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double size = 1.0
        float3 xformOp:scale = (50, 0.1, 50)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
