#usda 1.0
(
    """
    Schema definition for the Newton physics OpenExec plugin.
    References UsdPhysicsRigidBodyAPI from the core usdPhysics schema.
    """
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName       = "newtonPhysicsPlugin"
        string libraryPath       = "."
        bool skipCodeGeneration = true
    }
) {
}
