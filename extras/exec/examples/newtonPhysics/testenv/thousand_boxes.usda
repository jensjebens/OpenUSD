#usda 1.0
# 1000 rigid body boxes for physics stress testing.
# 10cm boxes in a 10x10x10 grid, 1m above ground plane.
# Spacing: 0.22m center-to-center (0.12m gap) for stable initial frame.
(
    defaultPrim = "World"
    endTimeCode = 480
    metersPerUnit = 1.0
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
    kilogramsPerUnit = 1.0
)

