#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1.0
    upAxis = "Y"
    doc = """AFTER: Same scene WITH units resolved.
    Transforms have been corrected to stage units (meters):
    - Red box: (200, 25, 0) cm → (2, 0.25, 0) m, size 50cm → 0.5m
    - Green box: (-2000, 250, 0) mm → (-2, 0.25, 0) m, size 500mm → 0.5m
    All three cubes are now 0.5m, side by side on the factory floor."""
)

def Xform "World"
{
    def DomeLight "DomeLight" {
        float inputs:intensity = 1.0
        float inputs:exposure = 1.0
        color3f inputs:color = (0.9, 0.92, 1.0)
    }

    def DistantLight "SunLight" {
        float inputs:intensity = 2.5
        float inputs:angle = 1.0
        color3f inputs:color = (1.0, 0.98, 0.9)
        double3 xformOp:rotateXYZ = (-45, 30, 0)
        token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Cube "Floor" {
        double size = 1
        double3 xformOp:scale = (20, 0.02, 20)
        double3 xformOp:translate = (0, -0.01, 0)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
    }

    # Blue cube: 1m reference (meter-scale, unchanged)
    def Cube "MeterCube" {
        double size = 1
        double3 xformOp:translate = (0, 0.5, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.15, 0.3, 0.85)]
    }

    # Red box: CORRECTED from cm to m
    # Original: size=50cm, translate=(200, 25, 0) cm
    # Corrected: size=0.5m, translate=(2, 0.25, 0) m
    def Xform "CmBox" {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = (
            (0.01, 0, 0, 0), (0, 0.01, 0, 0), (0, 0, 0.01, 0), (2, 0.25, 0, 1)
        )

        def Cube "Geo" {
            double size = 50
            color3f[] primvars:displayColor = [(0.85, 0.15, 0.1)]
        }
    }

    # Green box: CORRECTED from mm to m
    # Original: size=500mm, translate=(-2000, 250, 0) mm
    # Corrected: size=0.5m, translate=(-2, 0.25, 0) m
    def Xform "MmBox" {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = (
            (0.001, 0, 0, 0), (0, 0.001, 0, 0), (0, 0, 0.001, 0), (-2, 0.25, 0, 1)
        )

        def Cube "Geo" {
            double size = 500
            color3f[] primvars:displayColor = [(0.15, 0.7, 0.2)]
        }
    }

    # Same camera
    def Camera "Camera" {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 10000)
        double3 xformOp:translate = (0, 3, 8)
        double3 xformOp:rotateXYZ = (-15, 0, 0)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
