        uniform uint[] brep:edge3dNurb:curve3d:nurb:vertexCount = [2, 2, 2, 2, 7]
        uniform double[] brep:edge3dNurb:curve3d:nurb:knots = [0, 0, 20, 20, 0, 0, 20, 20, 0, 0, 20, 20, 0, 0, 20, 20, 0, 0, 0, 2.09439510239, 2.09439510239, 4.18879020479, 4.18879020479, 6.28318530718, 6.28318530718, 6.28318530718]
        uniform point3d[] brep:edge3dNurb:curve3d:nurb:controlVertices = [(-10, -10, 0), (10, -10, 0), (10, -10, 0), (10, 10, 0), (10, 10, 0), (-10, 10, 0), (-10, 10, 0), (-10, -10, 0), (3, 0, 0), (3, 5.19615242271, 0), (-1.5, 2.59807621135, 0), (-6, 0, 0), (-1.5, -2.59807621135, 0), (3, -5.19615242271, 0), (3, 0, 0)]
