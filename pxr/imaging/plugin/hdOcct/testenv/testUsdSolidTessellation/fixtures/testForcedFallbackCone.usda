#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    doc = """Full cone lateral surface (base radius 5 at z=0, apex (0,0,10),
semiAngle=atan(0.5)) authored the way a producer emits a pole-enclosing analytic
face with NO curveUv (pcurves): a single face whose only boundary edge is an
apex-to-rim meridian SEAM, face:range covering the full u-period and the full
AXIAL v-height [0,10]. The 3D-edge wire cannot bound the apex-enclosing patch,
so the builder falls to the parametric face:range route (!hasTrimCurves,
analyticSurf) -- the SAME rung testFullSphere forces. This fixture pins the cone
axial->slant v conversion (debt register row 1): the schema authors face:range v
as AXIAL distance along the axis, but OCCT's Geom_ConicalSurface v is SLANT
(v_slant = v_axial / cos(semiAngle)). Fed raw, the lateral patch is foreshortened
by cos(semiAngle) (~0.894) and the meshed area collapses from pi*R*slant ~= 175.6
to ~157. The area assertion in TestForcedFallbackCone catches the regression.
"""
)

def Xform "World"
{
    def BrepArray "FallbackCone" (
        prepend apiSchemas = ["BrepPointAPI:vertexPoint", "BrepCurve3dLineAPI:edge3dLine", "BrepSurfaceConeAPI"]
    )
    {
        uniform point3d[] brep:edge3dLine:curve3d:line:origin = [(0, 0, 10)]
        uniform vector3d[] brep:edge3dLine:curve3d:line:direction = [(0.4472135955, 0, -0.894427191)]
        uniform double3[] brep:extent = [(-5, -5, 0), (5, 5, 10)]
        uniform double[] brep:intersectTol3d = [0.000001]
        uniform uint[] brep:regionCount = [2]
        uniform vector3d[] brep:surface:cone:axis = [(0, 0, -1)]
        uniform point3d[] brep:surface:cone:origin = [(0, 0, 10)]
        uniform double[] brep:surface:cone:radius = [0]
        uniform vector3d[] brep:surface:cone:refDirection = [(1, 0, 0)]
        uniform double[] brep:surface:cone:semiAngle = [0.463647609001]
        uniform point3d[] brep:vertexPoint:point:position = [(0, 0, 10), (5, 0, 0)]
        uniform token[] edge:curveType = ["BrepCurve3dLineAPI"]
        uniform double[] edge:range = [0, 11.180339887499]
        uniform int2[] edge:vertexIndices = [(0, 1)]
        uniform uint[] edgeuse:edgeIndex = [0, 0]
        uniform uint[] edgeuse:nextRadialEUIndex = [1, 0]
        uniform token[] edgeuse:orientationType = ["same", "opposite"]
        uniform token[] edgeuse:thisRadialEntryType = ["topEntry", "bottomEntry"]
        uniform uint[] face:loopCount = [1]
        uniform double2[] face:range = [(0, 0), (6.28318530718, 10)]
        uniform token[] face:surfaceType = ["BrepSurfaceConeAPI"]
        uniform token[] face:trimType = ["general"]
        uniform uint[] faceuse:faceIndex = [0, 0]
        uniform token[] faceuse:orientationType = ["same", "opposite"]
        uniform uint[] loop:edgeuseCount = [2]
        uniform uint[] loop:vertexIndex = [0]
        uniform uint[] region:shellCount = [1, 1]
        uniform token[] region:type = ["voidRegion", "solidRegion"]
        uniform uint[] shell:faceuseCount = [1, 1]
        uniform token[] shell:pointType = ["none", "none"]
        uniform uint[] shell:wireEdgeCount = [0, 0]
        uniform token[] vertex:pointType = ["BrepPointAPI", "BrepPointAPI"]
        uniform token[] wireEdge:curveType = []
        uniform double[] wireEdge:range = []
        uniform int2[] wireEdge:vertexIndices = []
    }
}
