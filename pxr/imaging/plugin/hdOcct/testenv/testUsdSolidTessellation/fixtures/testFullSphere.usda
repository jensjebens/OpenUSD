#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

def Xform "World"
{
    def BrepArray "FullSphere" (
        prepend apiSchemas = ["BrepPointAPI:vertexPoint", "BrepCurve3dCircleAPI:edge3dCircle", "BrepSurfaceSphereAPI"]
    )
    {
        uniform vector3d[] brep:edge3dCircle:curve3d:circle:axis = [(0, 1, 0)]
        uniform point3d[] brep:edge3dCircle:curve3d:circle:center = [(0, 0, 0)]
        uniform double[] brep:edge3dCircle:curve3d:circle:radius = [2]
        uniform vector3d[] brep:edge3dCircle:curve3d:circle:refDirection = [(0, 0, 1)]
        uniform double[] brep:intersectTol3d = [0.000001]
        uniform uint[] brep:regionCount = [2]
        uniform vector3d[] brep:surface:sphere:axis = [(0, 0, 1)]
        uniform point3d[] brep:surface:sphere:center = [(0, 0, 0)]
        uniform double[] brep:surface:sphere:radius = [2]
        uniform vector3d[] brep:surface:sphere:refDirection = [(1, 0, 0)]
        uniform point3d[] brep:vertexPoint:point:position = [(0, 0, 2), (0, 0, -2)]
        uniform token[] edge:curveType = ["BrepCurve3dCircleAPI"]
        uniform double[] edge:range = [0, 3.14159265359]
        uniform int2[] edge:vertexIndices = [(0, 1)]
        uniform uint[] edgeuse:edgeIndex = [0, 0]
        uniform uint[] edgeuse:nextRadialEUIndex = [1, 0]
        uniform token[] edgeuse:orientationType = ["same", "opposite"]
        uniform token[] edgeuse:thisRadialEntryType = ["topEntry", "bottomEntry"]
        uniform uint[] face:loopCount = [1]
        uniform double2[] face:range = [(0, -1.570796326795), (6.28318530718, 1.570796326795)]
        uniform token[] face:surfaceType = ["BrepSurfaceSphereAPI"]
        uniform token[] face:trimType = ["general"]
        uniform uint[] faceuse:faceIndex = [0, 0]
        uniform token[] faceuse:orientationType = ["same", "opposite"]
        uniform uint[] loop:edgeuseCount = [2]
        uniform uint[] loop:vertexIndex = [0]
        uniform uint[] region:shellCount = [1, 1]
        uniform token[] region:type = ["voidRegion", "solidRegion"]
        uniform uint[] shell:faceuseCount = [1, 1]
        uniform token[] shell:pointType = ["none"]
        uniform uint[] shell:wireEdgeCount = [0, 0]
        uniform token[] vertex:pointType = ["BrepPointAPI", "BrepPointAPI"]
    }
}

