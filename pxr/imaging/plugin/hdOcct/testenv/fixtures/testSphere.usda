#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Generated BrepArray test fixture.
    Sphere radius=5 centered at origin. Single rational NURBS surface.
    Standard representation: degree 2 in u (longitude, 9 poles) and v (latitude, 5 poles).
    Expected volume: 4/3 * pi * 5^3 ≈ 523.6"""
)

def Xform "World"
{
    def BrepArray "Sphere"
    {
        # Topology
        uniform uint[] brep:regionCount = [1]
        uniform uint[] region:shellCount = [1]
        uniform token[] region:type = ["solidRegion"]
        uniform uint[] shell:faceuseCount = [2]
        uniform uint[] shell:wireEdgeCount = [0]
        uniform uint[] face:loopCount = [1]
        uniform token[] face:surfaceType = ["BrepSurfaceNurbAPI"]
        uniform token[] face:trimType = ["natural"]
        uniform double2[] face:range = [(0, 6.2831853072), (0, 3.1415926536)]
        uniform token[] faceuse:orientationType = ["opposite", "same"]
        uniform uint[] loop:edgeuseCount = [0]
        uniform uint[] loop:vertexIndex = [0]

        # Vertex positions
        uniform point3d[] brep:vertexPoint:point:position = [(0, 0, -5), (0, 0, 5)]

        # NURBS surface: 9x5, degree 2x2, rational
        uniform uint[] brep:surface:nurb:uVertexCount = [9]
        uniform uint[] brep:surface:nurb:vVertexCount = [5]
        uniform uint[] brep:surface:nurb:uOrder = [3]
        uniform uint[] brep:surface:nurb:vOrder = [3]
        uniform double[] brep:surface:nurb:uKnots = [0, 0, 0, 1.5707963268, 1.5707963268, 3.1415926536, 3.1415926536, 4.7123889804, 4.7123889804, 6.2831853072, 6.2831853072, 6.2831853072]
        uniform double[] brep:surface:nurb:vKnots = [0, 0, 0, 1.5707963268, 1.5707963268, 3.1415926536, 3.1415926536, 3.1415926536]

        # 45 control points (v-major: for each latitude row, 9 longitude points)
        # Row 0: south pole (degenerate)
        # Row 1: 45° south (z=-5, r=5)
        # Row 2: equator (z=0, r=5)
        # Row 3: 45° north (z=5, r=5)
        # Row 4: north pole (degenerate)
        uniform point3d[] brep:surface:nurb:controlVertices = [(0, 0, -5), (0, 0, -5), (0, 0, -5), (0, 0, -5), (0, 0, -5), (0, 0, -5), (0, 0, -5), (0, 0, -5), (0, 0, -5), (5, 0, -5), (5, 5, -5), (0, 5, -5), (-5, 5, -5), (-5, 0, -5), (-5, -5, -5), (0, -5, -5), (5, -5, -5), (5, 0, -5), (5, 0, 0), (5, 5, 0), (0, 5, 0), (-5, 5, 0), (-5, 0, 0), (-5, -5, 0), (0, -5, 0), (5, -5, 0), (5, 0, 0), (5, 0, 5), (5, 5, 5), (0, 5, 5), (-5, 5, 5), (-5, 0, 5), (-5, -5, 5), (0, -5, 5), (5, -5, 5), (5, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5), (0, 0, 5)]

        # Weights: product of u_weight * v_weight
        # u: [1, w, 1, w, 1, w, 1, w, 1] with w = sqrt(2)/2 ≈ 0.7071
        # v: [1, w, 1, w, 1]
        uniform double[] brep:surface:nurb:weights = [1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 0.5, 0.7071067812, 0.5, 0.7071067812, 0.5, 0.7071067812, 0.5, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 0.5, 0.7071067812, 0.5, 0.7071067812, 0.5, 0.7071067812, 0.5, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1, 0.7071067812, 1]

        # Tolerance
        uniform double[] brep:intersectTol3d = [0.000001]
    }
}
