#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
    doc = """Generated BrepArray test fixture.
    Single planar face 10x10 (bilinear NURBS). Tests: basic surface, untrimmed face.
    Expected volume: 0
    Expected face count: 1"""
)

def Xform "World"
{
    def BrepArray "Plane"
    {
        # Topology
        uniform uint[] brep:regionCount = [1]
        uniform uint[] region:shellCount = [1]
        uniform token[] region:type = ["solidRegion"]
        uniform uint[] shell:faceuseCount = [2]
        uniform uint[] shell:wireEdgeCount = [0]
        uniform uint[] face:loopCount = [1]
        uniform token[] face:surfaceType = ["BrepSurfaceNurbAPI"]
        uniform token[] face:trimType = ["general"]
        uniform double2[] face:range = [(0, 10), (0, 10)]
        uniform uint[] loop:edgeuseCount = [4]
        uniform uint[] loop:vertexIndex = [1]
        uniform uint[] edgeuse:edgeIndex = [0, 1, 2, 3]
        uniform token[] edgeuse:orientationType = ["opposite", "same", "same", "opposite"]
        uniform token[] faceuse:orientationType = ["same", "opposite"]

        # Edge topology
        uniform token[] edge:curveType = ["BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI"]
        uniform double[] edge:range = [0, 10, 0, 10, 0, 10, 0, 10]
        uniform int2[] edge:vertexIndices = [(1, 0), (0, 2), (2, 3), (3, 1)]

        # Vertex positions
        uniform point3d[] brep:vertexPoint:point:position = [(0, 0, 0), (0, 10, 0), (10, 0, 0), (10, 10, 0)]

        # NURBS surfaces
        uniform uint[] brep:surface:nurb:uVertexCount = [2]
        uniform uint[] brep:surface:nurb:vVertexCount = [2]
        uniform uint[] brep:surface:nurb:uOrder = [2]
        uniform uint[] brep:surface:nurb:vOrder = [2]
        uniform double[] brep:surface:nurb:uKnots = [0, 0, 10, 10]
        uniform double[] brep:surface:nurb:vKnots = [0, 0, 10, 10]
        uniform point3d[] brep:surface:nurb:controlVertices = [(0, 0, 0), (0, 10, 0), (10, 0, 0), (10, 10, 0)]

        # NURBS 3D edge curves
        uniform uint[] brep:edge3dNurb:curve3d:nurb:vertexCount = [2, 2, 2, 2]
        uniform uint[] brep:edge3dNurb:curve3d:nurb:order = [2, 2, 2, 2]
        uniform double[] brep:edge3dNurb:curve3d:nurb:knots = [0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10]
        uniform point3d[] brep:edge3dNurb:curve3d:nurb:controlVertices = [(0, 0, 0), (0, 10, 0), (0, 0, 0), (10, 0, 0), (10, 0, 0), (10, 10, 0), (0, 10, 0), (10, 10, 0)]

        # NURBS UV trim curves (pcurves)
        uniform uint[] brep:curveUv:nurb:vertexCount = [2, 2, 2, 2]
        uniform uint[] brep:curveUv:nurb:order = [2, 2, 2, 2]
        uniform double[] brep:curveUv:nurb:knots = [0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10]
        uniform point3d[] brep:curveUv:nurb:controlVertices = [(0, 0, 0), (0, 10, 0), (0, 0, 0), (10, 0, 0), (10, 0, 0), (10, 10, 0), (0, 10, 0), (10, 10, 0)]

        # Tolerance
        uniform double[] brep:intersectTol3d = [1e-6]
    }
}
