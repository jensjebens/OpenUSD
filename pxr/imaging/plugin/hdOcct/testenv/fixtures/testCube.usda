        # NURBS surfaces
        uniform uint[] brep:surface:nurb:uVertexCount = [2, 2, 2, 2, 2, 2]
        uniform uint[] brep:surface:nurb:vVertexCount = [2, 2, 2, 2, 2, 2]
        uniform uint[] brep:surface:nurb:uOrder = [2, 2, 2, 2, 2, 2]
        uniform uint[] brep:surface:nurb:vOrder = [2, 2, 2, 2, 2, 2]
        uniform double[] brep:surface:nurb:uKnots = [0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10]
        uniform double[] brep:surface:nurb:vKnots = [-10, -10, 0, 0, -10, -10, 0, 0, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10]
        uniform point3d[] brep:surface:nurb:controlVertices = [(0, 10, 0), (0, 0, 0), (0, 10, 10), (0, 0, 10), (10, 10, 0), (10, 0, 0), (10, 10, 10), (10, 0, 10), (0, 0, 0), (10, 0, 0), (0, 0, 10), (10, 0, 10), (0, 10, 0), (10, 10, 0), (0, 10, 10), (10, 10, 10), (0, 0, 0), (0, 10, 0), (10, 0, 0), (10, 10, 0), (0, 0, 10), (0, 10, 10), (10, 0, 10), (10, 10, 10)]

        # NURBS 3D edge curves
        uniform uint[] brep:edge3dNurb:curve3d:nurb:vertexCount = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
        uniform uint[] brep:edge3dNurb:curve3d:nurb:order = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
        uniform double[] brep:edge3dNurb:curve3d:nurb:knots = [0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10]
        uniform point3d[] brep:edge3dNurb:curve3d:nurb:controlVertices = [(0, 0, 0), (0, 0, 10), (0, 0, 10), (0, 10, 10), (0, 10, 0), (0, 10, 10), (0, 0, 0), (0, 10, 0), (10, 0, 0), (10, 0, 10), (10, 0, 10), (10, 10, 10), (10, 10, 0), (10, 10, 10), (10, 0, 0), (10, 10, 0), (0, 0, 0), (10, 0, 0), (0, 0, 10), (10, 0, 10), (0, 10, 0), (10, 10, 0), (0, 10, 10), (10, 10, 10)]

        # NURBS UV trim curves (pcurves)
        uniform uint[] brep:curveUv:nurb:vertexCount = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
        uniform uint[] brep:curveUv:nurb:order = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
        uniform double[] brep:curveUv:nurb:knots = [0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10, 0, 0, 10, 10]
        uniform point3d[] brep:curveUv:nurb:controlVertices = [(0, 0, 0), (10, 0, 0), (10, 0, 0), (10, -10, 0), (0, -10, 0), (10, -10, 0), (0, 0, 0), (0, -10, 0), (0, 0, 0), (10, 0, 0), (10, 0, 0), (10, -10, 0), (0, -10, 0), (10, -10, 0), (0, 0, 0), (0, -10, 0), (0, 0, 0), (0, 10, 0), (0, 10, 0), (10, 10, 0), (10, 0, 0), (10, 10, 0), (0, 0, 0), (10, 0, 0), (0, 0, 0), (0, 10, 0), (0, 10, 0), (10, 10, 0), (10, 0, 0), (10, 10, 0), (0, 0, 0), (10, 0, 0), (0, 0, 0), (0, 10, 0), (0, 10, 0), (10, 10, 0), (10, 0, 0), (10, 10, 0), (0, 0, 0), (10, 0, 0), (0, 0, 0), (0, 10, 0), (0, 10, 0), (10, 10, 0), (10, 0, 0), (10, 10, 0), (0, 0, 0), (10, 0, 0)]

