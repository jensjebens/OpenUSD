        uniform token[] faceuse:orientationType = ["opposite", "same", "same", "opposite", "opposite", "same", "same", "opposite", "opposite", "same", "same", "opposite"]

        # Edge topology
        uniform token[] edge:curveType = ["BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI", "BrepCurve3dNurbAPI"]
        uniform double[] edge:range = [0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10, 0, 10]
        uniform int2[] edge:vertexIndices = [(1, 0), (0, 2), (2, 3), (3, 1), (4, 5), (6, 4), (7, 6), (5, 7), (1, 5), (4, 0), (7, 3), (2, 6)]

        # Vertex positions
