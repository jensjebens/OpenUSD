#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
    doc = """Generated BrepArray test fixture.
    Box 10x10x10 (6 planar faces). Tests: multi-face solid, edge topology, closed shell.
    Expected volume: 1000
    Expected face count: 6"""
)

def Xform "World"
{
    def BrepArray "Cube"
    {
        # Topology
        uniform uint[] brep:regionCount = [1]
        uniform uint[] region:shellCount = [1]
        uniform token[] region:type = ["solidRegion"]
